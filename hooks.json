{
  "agy-quota-manager": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./scripts/agy_quota_hook.py pre",
        "timeout": 30
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 ./scripts/agy_quota_hook.py post",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./scripts/agy_quota_hook.py stop",
        "timeout": 30
      }
    ]
  }
}
